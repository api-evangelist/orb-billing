          "name": "Ingest events",
          "request": {
            "name": "Ingest events",
            "description": {
              "content": "Ingests a batch of usage events into Orb's metering pipeline. Each event is idempotent via its idempotency_key and must reference exactly one of customer_id or external_customer_id. Pass debug=true to receive a per-event accept/duplicate breakdown in the response.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ingest"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "debug",
                  "value": "<boolean>",
                  "description": "When true, returns a debug breakdown of processed and ignored events."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
